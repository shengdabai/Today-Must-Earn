{
  "name": "money-today",
  "version": "0.1.0",
  "description": "《今天也得赚钱》— 用黑色幽默把你从摸鱼里薅回工位的桌面应用",
  "main": "dist-electron/main.js",
  "author": "Tony",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.tony.moneytoday",
    "productName": "今天也得赚钱",
    "directories": { "output": "release" },
    "files": ["dist", "dist-electron"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"]
    }
  },
  "overrides": {
    "tar": "^7.5.22",
    "undici@^6.0.0": "6.29.1",
    "undici@^7.0.0": "7.30.1",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.4"
  }
}
